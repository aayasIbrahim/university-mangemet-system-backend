model InstructorProfile {
  id           String             @id @default(uuid()) @db.Uuid
  

  userId       String             @unique @db.Uuid
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  

  employeeIdNo String             @unique @db.VarChar(30) // e.g., "EMP-2026-004"
  designation  String             @db.VarChar(50)  // e.g., "Assistant Professor", "Lecturer"
  joiningDate  DateTime           @db.Date
  
  
  departmentId String             @db.Uuid
  department   Department         @relation(fields: [departmentId], references: [id])
  
 
  specialization String?          @db.Text         // e.g., "Machine Learning, Cryptography"
  roomNumber     String?          @db.VarChar(15)  // e.g., "Room 502-A"
  status         InstructorStatus @default(ACTIVE)  
 
  sections     Section[]
  exams        Exam[]
  submittedMarks ExamMark[] @relation("InstructorMarkSubmitter")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([departmentId, status])
  @@map("instructor_profiles")
}
