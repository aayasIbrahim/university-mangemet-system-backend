model TranscriptEntry {
  id            String     @id @default(uuid()) @db.Uuid
  transcriptId  String     @db.Uuid
  transcript    Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  courseId      String     @db.Uuid
  course        Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseCode    String     @db.VarChar(20)
  courseTitle   String     @db.VarChar(150)
  credits       Decimal    @db.Decimal(4, 2)
  letterGrade   String?    @db.VarChar(5)
  gradePoint    Decimal?   @db.Decimal(4, 2)
  qualityPoints Decimal    @db.Decimal(6, 2)
  isPassed      Boolean    @default(false)

  @@unique([transcriptId, courseId])
  @@index([courseId])
  @@map("transcript_entries")
}