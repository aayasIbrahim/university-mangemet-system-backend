model StudentApplication {
  id              String                   @id @default(uuid()) @db.Uuid
  applicationNo   String                   @unique @db.VarChar(40)
  firstName       String                   @db.VarChar(100)
  middleName      String?                  @db.VarChar(100)
  lastName        String                   @db.VarChar(100)
  email           String                   @unique @db.VarChar(320)
  phone           String?                  @db.VarChar(32)
  passwordHash    String                   @db.VarChar(255)
  programId       String                   @db.Uuid
  program         Program                  @relation(fields: [programId], references: [id], onDelete: Restrict)
  batch           String                   @db.VarChar(50)
  address         String                   @db.Text
  emergencyPhone  String?                  @db.VarChar(32)
  resumeUrl       String?                  @db.VarChar(2048)
  additionalFiles Json?
  emailVerified   Boolean                  @default(false)
  verifiedAt      DateTime?
  status          StudentApplicationStatus @default(PENDING)
  rejectionReason String?                  @db.VarChar(500)
  reviewedById    String?                  @db.Uuid
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([programId, status])
  @@map("student_applications")
}