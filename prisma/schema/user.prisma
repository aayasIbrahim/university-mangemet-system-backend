model User {
  id                 String             @id @default(uuid()) @db.Uuid
  email              String             @unique @db.VarChar(320)
  password           String?            @db.VarChar(255)
  emailVerified      Boolean            @default(false)
  firstName          String             @db.VarChar(100)
  middleName         String?            @db.VarChar(100)
  lastName           String             @db.VarChar(100)
  phone              String?            @db.VarChar(32)
  imageUrl           String             @default("") @db.VarChar(2048)
  imagePublicId      String             @default("") @db.VarChar(255)
  role               Role               @default(STUDENT)
  isActive           Boolean            @default(true)
  emailVerifiedAt    DateTime?
  googleId           String?            @unique
  authProvider       AuthProvider       @default(CREDENTIAL)
  status             UserStatus         @default(ACTIVE)
  needPasswordChange Boolean            @default(false)
  isDeleted          Boolean            @default(false)
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  studentProfile     StudentProfile?
  generatedReports   AcademicReport[]   @relation("AcademicReportGenerator")
  instructorProfile  InstructorProfile?
  departmentAdmin    Department?        @relation("DepartmentAdmin")
  attendances        Attendance[]       @relation("AttendanceEvaluator")
  createdInvoices    Invoice[]          @relation("InvoiceCreator")
  createdRefunds     Refund[]           @relation("RefundCreator")

  @@index([role])
  @@index([isActive])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}
