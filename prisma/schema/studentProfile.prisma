model StudentProfile {
  id             String           @id @default(uuid()) @db.Uuid
  studentIdNo    String?          @unique @db.VarChar(32)
  status         StudentStatus @default(ACTIVE)
  enrollmentDate DateTime         @default(now())
  batch          String?          @db.VarChar(50)
  department     String?          @db.VarChar(120)
  semester       Int?
  address        String?          @db.Text
  emergencyPhone String?          @db.VarChar(32)
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userId         String           @unique @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  programId      String?              @db.Uuid
  program        Program?         @relation(fields: [programId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  enrollments CourseEnrollment[]
  attendances Attendance[]
  examMarks ExamMark[]
  @@index([status])
  @@index([studentIdNo])
  @@index([isDeleted])
  @@index([programId])
  @@map("student_profiles")
}